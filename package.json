{
  "name": "arkiapuri_api",
  "version": "1.0.0",
  "description": "API for Arkiapuri mobile app.",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "tsx watch --env-file=.env app.ts",
    "dev:once": "tsx --env-file=.env app.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "deploy": "npm run build && railway up",
    "check-env": "tsx --env-file=.env src/utils/check-env.ts",
    "eval:pantry-scan": "tsx --env-file=.env scripts/eval/pantry-scan/run.ts"
  },
  "author": "Anna Tiala",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.18.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^8.6.0",
    "express": "^4.17.1",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^6.10.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.5",
    "glob": "11.1.0"
  }
}
