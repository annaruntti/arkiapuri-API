# -----------------------------------------------------------------------------
# Arkiapuri API — copy to `.env` for local use. Never commit real secrets.
# Full staging/prod matrix: docs/ENV.md
# Generate JWT: openssl rand -hex 32
# -----------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
PORT=3000

# Public base URL of THIS API (OAuth provider callbacks use ${APP_URL}/auth/.../callback)
APP_URL=http://localhost:3000

# Comma-separated browser origins allowed to call the API (required; enforced in production)
CORS_ORIGIN=http://localhost:8081

# --- Database (secret) ---
MONGODB_URI=mongodb://127.0.0.1:27017/arkiapuri

# --- Auth (secret) ---
# Must be at least 32 characters in every environment
JWT_SECRET=replace-with-openssl-rand-hex-32-output-here!!

# OAuth redirect targets after provider login (auth code in query, not JWT)
# Mobile custom scheme (or Universal Link later)
MOBILE_REDIRECT_URI=arkiapuri://auth/callback
# Web SPA callback route
WEB_REDIRECT_URI=http://localhost:8081/AuthCallback
# Used in invite/verify/reset email links and as WEB_REDIRECT_URI fallback
WEB_URL=http://localhost:8081
# Deep-link base for invite emails (native)
FRONTEND_URL=arkiapuri://

# --- Google OAuth (secret: CLIENT_SECRET only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional extra audiences for ID-token verify (native apps)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- Apple Sign In (secret: CLIENT_SECRET) ---
APPLE_CLIENT_ID=
APPLE_SERVICE_ID=
APPLE_CLIENT_SECRET=

# --- Facebook Login (secret: APP_SECRET) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Cloudinary (secrets) ---
CLOUDINARY_USER_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_KEY_SECRET=
# Alias also accepted by code:
# CLOUDINARY_API_SECRET=

# --- Email / SMTP (secrets) ---
# Either EMAIL_SERVICE=gmail with USER/PASSWORD, or custom HOST/PORT
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
# EMAIL_PASS=   # alias for EMAIL_PASSWORD
EMAIL_FROM_ADDRESS=
# EMAIL_FROM=   # alias
# Custom SMTP instead of service:
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_SECURE=false

# --- AI / Gemini (secret: API key) ---
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # alias
AI_MODEL=gemini-3.5-flash-lite
AI_MONTHLY_CREDIT_LIMIT=40
AI_MONTHLY_BUDGET_USD=20
AI_HOUSEHOLD_MEMBER_LIMIT=
AI_INPUT_USD_PER_MILLION=0.1
AI_OUTPUT_USD_PER_MILLION=
# NEVER set true in production (process exits)
AI_GRANT_PREMIUM=false
